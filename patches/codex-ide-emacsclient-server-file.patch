+(defun codex-ide-mcp-bridge--tcp-file-owner (file)
+  "Return the PID in FILE's header, without exposing the authentication key."
+  (when (file-readable-p file)
+    (with-temp-buffer
+      (insert-file-contents-literally file nil 0 128)
+      (when (looking-at "[^ \n]+ \\([0-9]+\\)")
+        (string-to-number (match-string 1))))))
 
 ;;;###autoload
 (defun codex-ide-mcp-bridge-status ()
@@ -234,7 +244,8 @@ Errors from `server-running-p' are treated as nil."
          (server-running (and enabled
                               (codex-ide-mcp-bridge--ensure-server-running-p
                                server-name)))
-         (ready (and enabled
+         (ready (and enabled server-running
+                     (processp server-process) (process-live-p server-process)
                      (file-exists-p script-path)
                      python-path
                      emacsclient-path)))
@@ -252,11 +263,39 @@ Errors from `server-running-p' are treated as nil."
 
 ;;;###autoload
 (defun codex-ide-mcp-bridge-ensure-server ()
-  "Ensure the target Emacs server for the bridge is running."
+  "Ensure this Emacs owns the server targeted by the bridge.
+Never attach the bridge to another Emacs or remove its connection file."
   (when (codex-ide-mcp-bridge-enabled-p)
-    (let ((server-name (codex-ide-mcp-bridge--resolved-server-name)))
-      (unless (codex-ide-mcp-bridge--ensure-server-running-p server-name)
-        (server-start nil codex-ide-suppress-server-start-prompts)))))
+    (let* ((target (codex-ide-mcp-bridge--resolved-server-name))
+           (directory (if server-use-tcp server-auth-dir server-socket-dir))
+           (file (expand-file-name server-name directory)))
+      (unless (equal (expand-file-name target directory) file)
+        (user-error "MCP target differs from this Emacs server: %s" target))
+      (unless (and (processp server-process)
+                   (process-live-p server-process))
+        ;; TCP's stock running check recognizes only 127.0.0.1 headers.
+        ;; Treat any other live file owner conservatively, including PID reuse.
+        (let ((owner (and server-use-tcp
+                          (codex-ide-mcp-bridge--tcp-file-owner file))))
+          (when (and owner (/= owner (emacs-pid)) (process-attributes owner))
+            (user-error "Emacs server file belongs to live PID %s; inspect %s before recovery"
+                        owner file))
+          ;; A stopped listener can leave a file naming this very Emacs.
+          ;; The PID-only stock check would otherwise mistake it for a peer.
+          (when (and owner (= owner (emacs-pid)))
+            (when (process-live-p (get-process server-name))
+              (user-error "A live listener named %s exists; inspect it before recovery" server-name))
+            (let (delete-by-moving-to-trash) (delete-file file))))
+        (when (eq t (server-running-p server-name))
+          (user-error "Another process owns Emacs server %s; inspect it before recovery" file))
+        ;; `server-start' removes stale TCP files and Unix sockets itself.
+        ;; In particular, :other from `server-running-p' must not skip this.
+        (server-start nil codex-ide-suppress-server-start-prompts)
+        (message "Emacs MCP server: pid=%s transport=%s endpoint=%s"
+                 (emacs-pid) (if server-use-tcp "tcp" "local") file))
+      (unless (and (processp server-process)
+                   (process-live-p server-process))
+        (error "Emacs server did not start: %s" file)))))
 
